# Set these on the always-on MINE-ME pool gateway service.
NODE_ENV=production
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=8081
GATEWAY_WS_PATH=/ws
ALLOWED_WEB_ORIGINS=https://app.example.com
TRUST_PROXY_HEADERS=true
MAX_ACTIVE_WORKERS=1000
MAX_PENDING_AUTH_CONNECTIONS=100
MAX_CONNECTION_ATTEMPTS_PER_MINUTE=300

POOL_PROXY_HOST=127.0.0.1
POOL_PROXY_PORT=3333

SUPABASE_URL=https://mqyqpflamkplhlphrngn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
MINING_GATEWAY_TOKEN_SECRET=replace-with-at-least-32-random-bytes
